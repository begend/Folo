# Web URL
VITE_WEB_URL=http://localhost:2233

# API URL - 修改为本地开发地址
VITE_API_URL=http://localhost:3000

# Image Proxy URL
VITE_IMGPROXY_URL=http://localhost:2873

# Sentry DSN (可选，用于错误监控)
VITE_SENTRY_DSN=

# Build type
VITE_BUILD_TYPE=development

# Inbox email domain
VITE_INBOXES_EMAIL=@follow.re

# Editor preference
VITE_EDITOR=cursor

# PostHog analytics (可选，本地开发可留空)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
